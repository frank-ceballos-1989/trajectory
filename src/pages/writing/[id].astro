---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteArt from '../../components/NoteArt.astro';
import { getPosts, formatDate, readingMinutes } from '../../lib/writing';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, date, updated, tags, draft, filterable } = entry.data;
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description} ogType="article" published={date}>
  <article class="mx-auto max-w-[88rem] px-5 pb-28 pt-14 sm:px-8 lg:px-12 lg:pt-20">
    <header class="max-w-5xl">
      <p class="eyebrow text-graphite">
        <a href="/writing/" class="link-u py-1">Writing</a> · {formatDate(date)}
      </p>
      {draft && <p class="eyebrow mt-3 text-ember-deep">Draft · visible in dev only</p>}
      <h1 class="reveal display-soft mt-6 text-display-lg font-medium">{title}</h1>
      <p class="reveal mt-8 max-w-2xl font-display text-display-sm" style="--d:120ms">{description}</p>
    </header>

    <div class="mt-14 grid gap-12 border-t border-ink pt-10 lg:grid-cols-12">
      <aside class="lg:sticky lg:top-24 lg:col-span-3 lg:self-start">
        <dl class="divide-y divide-ink/20 border-y border-ink/20 text-sm">
          <div class="grid grid-cols-[5.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Author</dt><dd>{site.name}</dd></div>
          <div class="grid grid-cols-[5.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Published</dt><dd>{formatDate(date)}</dd></div>
          {updated && <div class="grid grid-cols-[5.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Updated</dt><dd>{formatDate(updated)}</dd></div>}
          <div class="grid grid-cols-[5.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Reading</dt><dd>{readingMinutes(entry.body)} min</dd></div>
          {tags.length > 0 && <div class="grid grid-cols-[5.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Filed under</dt><dd>{tags.join(', ')}</dd></div>}
        </dl>

        {
          sections.length > 1 && (
            <nav aria-label="In this article" class="mt-8">
              <p class="eyebrow text-graphite">In this article</p>
              <ol class="mt-3 max-h-[45vh] space-y-1 overflow-y-auto pr-2 text-sm">
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="link-u py-1">{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <a href="/writing/" class="link-u mt-8 inline-block py-1 text-sm">← All writing</a>
      </aside>

      <div class="min-w-0 lg:col-span-7 lg:col-start-5">
        {
          filterable && sections.length > 1 && (
            <form id="note-filter" class="note-filter mb-12 max-w-[40rem] border-y border-ink/25 py-6" role="search">
              <label for="note-search" class="eyebrow text-graphite">Find a note</label>
              <div class="mt-3 flex items-center gap-4">
                <input
                  id="note-search"
                  type="search"
                  list="note-names"
                  autocomplete="off"
                  placeholder="Type or pick a name"
                  class="w-full border border-ink/40 bg-paper px-4 py-3 text-base text-ink placeholder:text-graphite focus:border-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember-deep"
                />
                <button type="button" id="note-clear" class="eyebrow link-u shrink-0 py-2" hidden>Show all</button>
              </div>
              <datalist id="note-names">
                {sections.map((h) => <option value={h.text} />)}
              </datalist>
              <p id="note-status" class="mt-3 text-sm text-graphite" role="status" aria-live="polite" />
            </form>
          )
        }

        <div class:list={['prose-article max-w-[40rem]', filterable && 'prose-notes']}>
          {
            filterable ? (
              <NoteArt>
                <Content />
              </NoteArt>
            ) : (
              <Content />
            )
          }
        </div>

        <footer class="mt-16 max-w-[40rem] border-t border-ink/25 pt-6">
          <p class="eyebrow text-graphite">Written by {site.name}</p>
          <a href="/writing/" class="link-u mt-4 inline-block py-1 text-sm">← All writing</a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Name filter for articles with `filterable: true`. Each `##` section is one note; the intro before the first
  // section and everything after the closing `---` stay visible only while no filter is active.
  const input = document.querySelector<HTMLInputElement>('#note-search');
  const root = document.querySelector('.prose-notes');

  if (input && root) {
    const clear = document.querySelector<HTMLButtonElement>('#note-clear')!;
    const status = document.querySelector<HTMLElement>('#note-status')!;
    type Group = { name: string; els: Element[]; navItem: Element | null };

    const frame: Element[] = [];
    const groups: Group[] = [];
    let current: Group | null = null;
    let closing = false;

    for (const el of Array.from(root.children)) {
      if (el.tagName === 'HR') {
        closing = true;
        current = null;
      }
      if (closing) {
        frame.push(el);
      } else if (el.tagName === 'H2') {
        const navItem = document.querySelector(`nav[aria-label="In this article"] a[href="#${el.id}"]`)?.closest('li') ?? null;
        current = { name: (el.textContent ?? '').trim().toLowerCase(), els: [el], navItem };
        groups.push(current);
      } else if (current) {
        current.els.push(el);
      } else {
        frame.push(el);
      }
    }

    const apply = () => {
      const raw = input.value.trim();
      const q = raw.toLowerCase();
      const active = q.length > 0;
      let shown = 0;

      for (const g of groups) {
        const match = !active || g.name.includes(q);
        g.els.forEach((el) => el.toggleAttribute('hidden', !match));
        g.navItem?.toggleAttribute('hidden', !match);
        if (match) shown++;
      }
      frame.forEach((el) => el.toggleAttribute('hidden', active));

      clear.hidden = !active;
      const noun = (n: number) => `${n} ${n === 1 ? 'note' : 'notes'}`;
      status.textContent = !active
        ? noun(groups.length)
        : shown > 0
          ? `Showing ${shown} of ${noun(groups.length)}.`
          : `No note found for "${raw}".`;
    };

    input.addEventListener('input', apply);
    clear.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
    document.querySelector('#note-filter')?.addEventListener('submit', (e) => e.preventDefault());
    apply();
  }
</script>
