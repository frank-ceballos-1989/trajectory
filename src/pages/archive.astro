const archivedOn = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const earthzineUrl =
  'https://earthzine.org/update-gravitational-wave-galaxy-catalogue-for-the-rapid-search-of-electromagnetic-counterparts-from-gravitational-waves/';

const student = [
  ['Student', 'Frank Ceballos'],
  ['University', 'University of Texas at Brownsville'],
  ['Major', 'Physics'],
  ['Degree level', 'Bachelor of Science'],
  ['Internship site', 'NASA Glenn Research Center, Cleveland, Ohio'],
  ['Mentor', 'Jonah Kanner'],
];
---

<BaseLayout title="Archive" description="Preserved copies of work by Frank Ceballos: the Earthzine poster article, an arXiv abstract, and conference listings.">
  <section class="mx-auto max-w-[88rem] px-5 pb-10 pt-14 sm:px-8 lg:px-12 lg:pt-20">
    <p class="eyebrow text-graphite">Archive · Preserved with attribution</p>
    <h1 class="display-soft mt-6 font-medium !text-[clamp(3.5rem,13vw,12rem)] text-display-xl">Kept safe.</h1>
    <p class="mt-10 max-w-2xl text-xl leading-relaxed">
      Web pages disappear. These are the pieces of earlier work I most want to keep reachable, reproduced with credit and a link to where they were first published.
    </p>
    <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <a class="link-u py-1" href="#earthzine">Earthzine article · 2012</a>
      <a class="link-u py-1" href="#arxiv">arXiv · 2011</a>
      <a class="link-u py-1" href="#listings">Meeting listings</a>
    </nav>
  </section>

  <!-- ========== Earthzine ========== -->
  <article id="earthzine" class="scroll-mt-20 border-t border-ink bg-sand py-20 sm:py-28">
    <div class="mx-auto grid max-w-[88rem] gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:px-12">
      <aside class="lg:sticky lg:top-24 lg:col-span-4 lg:self-start">
        <p class="eyebrow text-graphite">01 · Article</p>
        <dl class="mt-6 divide-y divide-ink/20 border-y border-ink/20 text-sm">
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Publisher</dt><dd>IEEE Earthzine</dd></div>
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Published</dt><dd>October 24, 2012</dd></div>
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Categories</dt><dd>Original; URC Virtual Poster Session</dd></div>
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-3">
            <dt class="eyebrow pt-0.5 text-graphite">License</dt>
            <dd><a class="link-u" href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>, as stated by Earthzine</dd>
          </div>
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-3"><dt class="eyebrow pt-0.5 text-graphite">Archived</dt><dd>{archivedOn}</dd></div>
        </dl>
        <a href={earthzineUrl} target="_blank" rel="noopener noreferrer" class="link-u mt-6 inline-block py-1 text-sm">
          Original on earthzine.org ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </aside>

      <div class="lg:col-span-8">
        <h2 class="display-soft text-display-md">
          Update: Gravitational Wave Galaxy Catalogue for the Rapid Search of Electromagnetic Counterparts from Gravitational Waves
        </h2>

        <figure class="mt-10 border-l-2 border-ember-deep pl-5">
          <blockquote class="font-display text-xl italic leading-snug">
            “Physics student Frank Ceballos discovers that work at NASA Goddard can be challenging, yet fun.”
          </blockquote>
          <figcaption class="eyebrow mt-3 text-graphite">Photo caption as published · Image credit: URC · photo not archived here</figcaption>
        </figure>

        <dl class="mt-12 grid gap-px border border-ink/20 bg-ink/20 sm:grid-cols-2">
          {
            student.map(([k, v]) => (
              <div class="bg-sand p-4">
                <dt class="eyebrow text-graphite">{k}</dt>
                <dd class="mt-1 font-display text-lg">{v}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="eyebrow mt-14 text-graphite">Abstract</h3>
        <div class="mt-4 space-y-5 text-lg leading-[1.75]">
          <p>
            The Laser Interferometer Gravitational-Wave Observatory (LIGO) is a large-scale Michelson interferometer which aims to directly detect gravitational waves predicted by Albert Einstein in 1916. The gravitational waves sources that LIGO expects to detect consist of the merging of two neutron stars or a neutron and black hole at cosmic distances. It is anticipated that the coalescence of these compact objects may also produce a short-lived gamma ray burst (GRB). Unfortunately, LIGO is not accurate in localizing the points in the sky where the gravitational sources are to be found. The best that LIGO can do is to constrain a gravitational wave source in an area of approximately 100 square degrees, where literally millions of electromagnetic sources can be observed. So it seems that the simultaneous detection of gravitational and electromagnetic waves coming from a source is highly unlikely.
          </p>
          <p>
            To facilitate the task of searching for electromagnetic counterparts coming from gravitational waves, a list of galaxies within 100 Mpc has been compiled—the gravitational waves galaxy catalog (GWGC). LIGO is now being designed to improve its sensitivity by a factor of 10, which means that it would be able to observe neutron star/neutron star coalescence to distances of 300 Mpc and neutron star/black hole coalescence up to 650 Mpc. Therefore, GWGC must be updated to contain galaxies at these distances. We present the results of the updates made to GWGC.
          </p>
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-4">
          <a href="/archive/ceballos-gwgc-poster.pdf" class="btn group">
            Open the poster (PDF, 2.2 MB)
            <span aria-hidden="true" class="btn-arrow group-hover:translate-x-1">→</span>
          </a>
          <a
            href="https://earthzine.org/wp-content/uploads/2012/10/Poster_Ceballos_resample.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="link-u py-1 text-sm"
          >
            Poster at Earthzine ↗<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>

        <p class="mt-10 max-w-xl text-sm leading-relaxed text-graphite">
          Text reproduced from the article page; site navigation and unrelated page furniture are omitted. The caption is quoted exactly as published. Credit: Earthzine / IEEE Oceanic Engineering Society, licensed CC BY 4.0.
        </p>
      </div>
    </div>
  </article>

