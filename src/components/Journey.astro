---
import SectionLabel from './SectionLabel.astro';
import { journey } from '../data/journey';
---

<section id="journey" aria-labelledby="journey-title" class="bg-ink py-24 text-paper sm:py-32">
  <div class="mx-auto max-w-[88rem] px-5 sm:px-8 lg:px-12">
    <SectionLabel n="02" label="Journey" invert />

    <div class="mt-10 grid gap-8 lg:grid-cols-12">
      <h2 id="journey-title" class="reveal display-soft text-display-lg lg:col-span-7">
        From Brownsville to <em class="font-normal">three continents.</em>
      </h2>
      <p class="reveal text-lg leading-relaxed text-paper/75 lg:col-span-4 lg:col-start-9 lg:self-end">
        Six stops: a physics degree, a laser lab, a classroom, a radiation-oncology department, and two chapters at ExxonMobil. The instruments changed. The question stayed.
      </p>
    </div>

    <div id="journey-list" class="relative mt-20 [--col:0.5rem] md:mt-28 md:[--col:30%]">
      <div aria-hidden="true" class="pointer-events-none absolute bottom-0 top-0 w-px bg-paper/20" style="left:var(--col)">
        <span id="journey-progress" class="absolute inset-0 origin-top bg-ember"></span>
      </div>

      <ol>
      {
        journey.map((e) => (
          <li class="journey-item relative pb-20 pl-9 last:pb-0 md:grid md:grid-cols-[var(--col)_1fr] md:pb-28 md:pl-0">
            <span class="j-dot absolute top-[0.9rem] z-10 h-3.5 w-3.5 -translate-x-1/2 rounded-full border border-paper/55 bg-ink transition-all duration-500 ease-out md:top-[2.1rem]" style="left:var(--col)" aria-hidden="true" />
            <p class="j-year display-soft font-display text-[clamp(2.25rem,4.6vw,4.75rem)] leading-none tracking-tight md:pr-14 md:pt-3 md:text-right">
              {e.year}
            </p>
            <div class="mt-4 md:mt-0 md:pl-14">
              <p class="eyebrow text-ember">{e.org}</p>
              <h3 class="mt-3 text-display-md">{e.title}</h3>
              <p class="mt-5 max-w-xl text-lg leading-relaxed text-paper/80">{e.body}</p>
              {e.points && (
                <ul class="mt-5 max-w-xl space-y-2 text-paper/80">
                  {e.points.map((p) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="mt-[0.7em] h-px w-4 shrink-0 bg-ember" />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              )}
              {e.links && (
                <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 text-sm">
                  {e.links.map((l) => (
                    <a href={l.href} class="link-u py-1">
                      {l.label} →
                    </a>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style is:global>
  /* Outlined years that fill in as the line reaches them (JS only). */
  .js .journey-item .j-year {
    color: transparent;
    -webkit-text-stroke: 1px rgb(242 237 227 / 0.55);
    transition: color 0.6s ease, -webkit-text-stroke-color 0.6s ease;
  }
  .js .journey-item.is-active .j-year {
    color: #f2ede3;
    -webkit-text-stroke-color: #f2ede3;
  }
  .js .journey-item.is-active .j-dot {
    background: #e2512b;
    border-color: #e2512b;
    transform: translateX(-50%) scale(1.35);
  }
  .js #journey-progress {
    transform: scaleY(var(--p, 0));
  }
</style>

<script>
  const list = document.getElementById('journey-list');
  const bar = document.getElementById('journey-progress');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.journey-item'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function update() {
    if (!list || !bar) return;
    if (reduce.matches) {
      bar.style.setProperty('--p', '1');
      items.forEach((i) => i.classList.add('is-active'));
      return;
    }
    const rect = list.getBoundingClientRect();
    const mark = window.innerHeight * 0.55;
    const p = Math.min(1, Math.max(0, (mark - rect.top) / rect.height));
    bar.style.setProperty('--p', p.toFixed(4));
    items.forEach((i) => i.classList.toggle('is-active', i.getBoundingClientRect().top < mark));
  }

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  reduce.addEventListener('change', update);
</script>
