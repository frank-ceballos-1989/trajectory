---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-paper transition-colors duration-300">
  <div class="mx-auto flex max-w-[88rem] items-center justify-between px-5 py-4 sm:px-8 lg:px-12">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name}, home`}>
      <span class="relative grid h-9 w-9 place-items-center rounded-full bg-ink font-display text-sm text-paper">
        FC
        <span
          class="absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full bg-ember transition-transform duration-500 ease-out group-hover:translate-x-1 group-hover:-translate-y-1"
        ></span>
      </span>
      <span class="hidden font-display text-lg tracking-tight sm:inline">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav={item.href.replace('/#', '')} class="group flex items-baseline gap-1.5 text-sm">
                <span class="font-mono text-[0.65rem] text-graphite group-aria-[current=true]:text-ember-deep">{item.n}</span>
                <span class="link-u">{item.label}</span>
              </a>
            </li>
          ))
        }
        <li class="hidden md:block">
          <a
            href="/writing/"
            aria-current={path.startsWith('/writing') ? 'page' : undefined}
            class="link-u py-1 text-sm aria-[current=page]:text-ember-deep"
          >
            Writing
          </a>
        </li>
        <li class="hidden lg:block">
          <a
            href="/mcw"
            aria-current={path.startsWith('/mcw') ? 'page' : undefined}
            class="link-u py-1 text-sm aria-[current=page]:text-ember-deep"
          >
            MCW research
          </a>
        </li>
        <li>
          <a
            href="/publications"
            aria-current={path.startsWith('/publications') ? 'page' : undefined}
            class="rounded-full border border-ink px-4 py-1.5 text-sm transition-colors duration-300 hover:bg-ink hover:text-paper aria-[current=page]:bg-ink aria-[current=page]:text-paper"
          >
            Publications
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="eyebrow flex items-center gap-2 py-2 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-label">Menu</span>
      <span aria-hidden="true" class="relative block h-2.5 w-5">
        <span class="absolute left-0 top-0 h-px w-full bg-current transition-transform duration-300 ease-out" data-bar="1"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-current transition-transform duration-300 ease-out" data-bar="2"></span>
      </span>
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-ink/15 bg-paper md:hidden">
    <nav aria-label="Mobile" class="mx-auto max-w-[88rem] px-5 pb-8 pt-4 sm:px-8">
      <ul class="divide-y divide-ink/15">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="flex items-baseline justify-between py-4 font-display text-3xl">
                {item.label}
                <span class="font-mono text-xs text-graphite">{item.n}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/writing/" class="flex items-baseline justify-between py-4 font-display text-3xl">
            Writing
            <span class="font-mono text-xs text-graphite">→</span>
          </a>
        </li>
        <li>
          <a href="/mcw" class="flex items-baseline justify-between py-4 font-display text-3xl">
            MCW research
            <span class="font-mono text-xs text-graphite">→</span>
          </a>
        </li>
        <li>
          <a href="/publications" class="flex items-baseline justify-between py-4 font-display text-3xl">
            Publications
            <span class="font-mono text-xs text-graphite">→</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const panel = document.getElementById('mobile-menu')!;
  const label = document.getElementById('menu-label')!;
  const bars = btn.querySelectorAll<HTMLElement>('[data-bar]');

  function setOpen(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    label.textContent = open ? 'Close' : 'Menu';
    bars[0].style.transform = open ? 'translateY(4px) rotate(20deg)' : '';
    bars[1].style.transform = open ? 'translateY(-4px) rotate(-20deg)' : '';
  }

  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Hairline appears after scrolling
  const onScroll = () => header.classList.toggle('!border-ink/15', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mark the section in view (home page only)
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  if (links.length && 'IntersectionObserver' in window) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.dataset.nav!, l));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const link = map.get(e.target.id);
          if (link) link.setAttribute('aria-current', String(e.isIntersecting));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    map.forEach((_, id) => {
      const s = document.getElementById(id);
      if (s) io.observe(s);
    });
  }
</script>
