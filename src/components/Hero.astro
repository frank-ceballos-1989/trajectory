---
import Portrait from './Portrait.astro';
import { hero } from '../data/site';
---

<section aria-labelledby="hero-title" class="relative overflow-hidden">
  <!-- Trajectory: one continuous path, drawn on load -->
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1440 820"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <path
      class="draw"
      pathLength="1"
      d="M -20 780 C 200 780 330 620 480 575 S 760 470 860 410 S 1060 330 1130 255 S 1320 80 1410 58"
      fill="none"
      stroke="#E2512B"
      stroke-width="3"
      stroke-linecap="round"
    ></path>
    <g fill="#F2EDE3" stroke="#14110E" stroke-width="1.5">
      <circle class="pop" style="animation-delay:0.9s" cx="480" cy="575" r="7"></circle>
      <circle class="pop" style="animation-delay:1.4s" cx="860" cy="410" r="7"></circle>
      <circle class="pop" style="animation-delay:1.9s" cx="1130" cy="255" r="7"></circle>
    </g>
    <circle class="pop" style="animation-delay:2.5s" cx="1410" cy="58" r="11" fill="#E2512B" stroke="#14110E" stroke-width="1.5"></circle>
  </svg>

  <div class="relative mx-auto flex min-h-[calc(100svh-4.25rem)] max-w-[88rem] flex-col px-5 pb-8 pt-8 sm:px-8 lg:px-12 lg:pt-10">
    <p class="eyebrow reveal text-graphite">{hero.eyebrow}</p>

    <div class="relative mt-8 flex-1 [container-type:inline-size] lg:mt-8">
      <!-- Portrait beside the name. Name size, indent and figure width are all measured against this box (cqw), so they stay in proportion on any screen and the name never reaches the figure. -->
      <div class="hidden lg:absolute lg:right-[3%] lg:top-0 lg:block lg:w-[min(27cqw,24rem)] reveal" style="--d:300ms">
        <Portrait />
      </div>

      <h1 id="hero-title" class="relative z-10 display-soft text-display-xl font-medium lg:!text-[clamp(4.75rem,min(19cqw,26svh),17rem)]">
        <span class="reveal block">Frank</span>
        <span class="reveal block italic font-normal sm:ml-[6vw] lg:ml-[12cqw]" style="--d:140ms">Ceballos</span>
      </h1>

      <div class="relative z-10 mt-10 grid gap-10 lg:mt-10 lg:grid-cols-12">
        <div class="reveal lg:col-span-6 lg:col-start-2" style="--d:260ms">
          <p class="font-display text-display-sm">
            {hero.lede}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
            <a href="#about" class="btn group">
              Read the story
              <span aria-hidden="true" class="btn-arrow group-hover:translate-y-0.5">↓</span>
            </a>
            <a href="/publications" class="link-u py-1">Selected publications</a>
          </div>
        </div>

        <!-- Portrait on small screens -->
        <div class="reveal w-44 sm:w-56 lg:hidden">
          <Portrait />
        </div>
      </div>
    </div>

    <dl class="reveal relative z-10 mt-10 grid gap-px border-t border-ink/25 pt-5 sm:grid-cols-3">
      {
        hero.facts.map((f) => (
          <div class="pb-3 sm:pr-6">
            <dt class="eyebrow text-graphite">{f.k}</dt>
            <dd class="mt-1 font-display text-lg">{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
